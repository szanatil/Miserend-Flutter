default_platform(:android)

platform :android do
  # A release without the key would silently fall back to the keyless tile
  # URL, so a missing key stops the lane instead.
  def build_appbundle
    key = ENV["CARTO_API_KEY"].to_s
    UI.user_error!("CARTO_API_KEY is not set") if key.empty?

    sh("flutter", "clean")
    sh("flutter", "pub", "get")
    sh("flutter", "build", "appbundle", "--release", "--dart-define=CARTO_API_KEY=#{key}")
  end

  desc "Build and deploy to the Play Store production track"
  lane :deploy do
    build_appbundle

    upload_to_play_store(
      track: "production",
      aab: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    upload_to_play_store(
      track: "production",
      track_promote_to: "beta",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and deploy to the Play Store beta track"
  lane :beta do
    build_appbundle

    upload_to_play_store(
      track: "beta",
      aab: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
