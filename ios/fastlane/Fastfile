default_platform(:ios)

platform :ios do
  def signing_identity
    @signing_identity ||= begin
      output = `security find-identity -v -p codesigning`
      match = output.match(/"([^"]*Apple Distribution[^"]*)"/)
      UI.user_error!("No Apple Distribution signing identity found in keychain") unless match
      match[1]
    end
  end

  def unsigned_ipa_path
    ios_dir = File.expand_path("..", __dir__)
    zip_name = Dir.glob("*-ios-nosign.zip", base: ios_dir).first
    UI.user_error!("No *-ios-nosign.zip artifact found in #{ios_dir}") unless zip_name

    Dir.chdir(ios_dir) do
      sh("rm", "-rf", "build/ios/iphoneos", "Payload", "unsigned.ipa")
      sh("mkdir", "-p", "build/ios/iphoneos")
      sh("unzip", "-o", zip_name, "-d", "build/ios/iphoneos")
      sh("mkdir", "-p", "Payload")
      sh("cp", "-r", "build/ios/iphoneos/Runner.app", "Payload/")
      sh("zip", "-r", "unsigned.ipa", "Payload")
    end

    File.join(ios_dir, "unsigned.ipa")
  end

  def app_store_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APPLE_API_KEY_FILEPATH")
    )
  end

  def install_appstore_profile(api_key)
    match(
      type: "appstore",
      readonly: true,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      api_key: api_key,
      verbose: true
    )
  end

  def changelog(ios_dir)
    path = File.join(ios_dir, "..", "release-notes", "Miserend", "hu", "release_notes.txt")
    File.exist?(path) ? File.read(path).strip : "Új béta build"
  end

  desc "Deploy to the App Store"
  lane :deploy do
    setup_ci
    api_key = app_store_api_key
    install_appstore_profile(api_key)
    ios_dir = File.expand_path("..", __dir__)
    ipa = unsigned_ipa_path
    profile_path = ENV.fetch("sigh_com.horony.masstimes_appstore_profile-path")

    require "sigh"
    resign_script = File.join(Sigh::ROOT, "lib", "assets", "resign.sh")
    resign_cmd = "bash #{resign_script.shellescape} unsigned.ipa #{signing_identity.shellescape} -p #{profile_path.shellescape} -v unsigned.ipa"
    Dir.chdir(ios_dir) do
      sh(resign_cmd)
    end

    metadata_path = File.join(ios_dir, "..", "release-notes", "Miserend")

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: metadata_path,
      submission_information: { export_compliance_uses_encryption: false },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false
    )

  end

  desc "Deploy to TestFlight (beta)"
  lane :beta do
    setup_ci
    api_key = app_store_api_key
    install_appstore_profile(api_key)
    ios_dir = File.expand_path("..", __dir__)
    ipa = unsigned_ipa_path
    profile_path = ENV.fetch("sigh_com.horony.masstimes_appstore_profile-path")

    require "sigh"
    resign_script = File.join(Sigh::ROOT, "lib", "assets", "resign.sh")
    resign_cmd = "bash #{resign_script.shellescape} unsigned.ipa #{signing_identity.shellescape} -p #{profile_path.shellescape} -v unsigned.ipa"
    Dir.chdir(ios_dir) do
      sh(resign_cmd)
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      distribute_external: true,
      groups: ["Bárki"],
      notify_external_testers: true,
      changelog: changelog(ios_dir)
    )
  end
end
